<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:background="@color/color_primario"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="16dp"
    android:theme="@style/ThemeOverlay.AppCompat.Dark">

    <ImageView
        android:id="@+id/imagenHeader"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="Logo"
        android:scaleType="fitCenter"
        android:src="@drawable/logoretacar" />

    <TextView
        android:id="@+id/textHeaderTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:text="Alquiler Orellana"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/textHeaderUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Usuario: admin (Administrador)"
        android:textColor="@color/white"
        android:textSize="13sp" />

</LinearLayout>