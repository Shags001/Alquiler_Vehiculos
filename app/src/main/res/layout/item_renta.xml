<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRenta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/superficie_tarjeta"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/textClienteRenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/textEstadoRentaBadge"
                android:text="Carlos Orellana"
                android:textColor="@color/texto_principal"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textEstadoRentaBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_badge_rentado"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Activa"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:id="@+id/textVehiculoRenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vehículo: Toyota Hilux 2023 (P-458921)"
            android:textColor="@color/texto_principal"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/textFechasRenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Fechas: 2025-02-10 a 2025-02-15 (5 días)"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/linea_divisoria" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textMontoTotalRenta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total: $325.00"
                    android:textColor="@color/texto_principal"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textSaldoPendienteRenta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saldo Pendiente: $125.00"
                    android:textColor="@color/estado_rentado"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonFinalizarRenta"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Devolver"
                android:textColor="@color/color_primario_oscuro"
                app:strokeColor="@color/color_primario" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>